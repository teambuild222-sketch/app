# Copy to backend/.env for local dev. Never commit the real .env.
# Production template: .env.production.example + DEPLOY_PHASE1.md

# --- Environment ---
# development (default) | production — production enforces Postgres, durable media, strong JWT
ENVIRONMENT=development

# --- Database ---
# Local:
DATABASE_URL=sqlite+aiosqlite:///./simsor.db
# Supabase pooler (encode @ in password as %40):
# DATABASE_URL=postgresql+asyncpg://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth ---
# Use Supabase Settings → API → Legacy JWT secret when using Realtime chat
JWT_SECRET=dev-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- CORS ---
CORS_ORIGINS=*

# --- Durable media (Phase 1) — Option A: Supabase Storage ---
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # Settings → API → service_role (keep secret)
# SUPABASE_STORAGE_BUCKET=media

# --- Durable media — Option B: Cloudflare R2 ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL_BASE=

# --- Social login (optional) ---
# GOOGLE_CLIENT_ID=          # OAuth client ID for POST /api/auth/google
# APPLE_CLIENT_ID=           # Sign in with Apple (verification TBD)

# --- Email (reset + verification). Unset in dev → tokens are echoed in API responses ---
# RESEND_API_KEY=
# EMAIL_FROM=SIMSOR <onboarding@resend.dev>
# PUBLIC_APP_URL=https://app.example.com   # adds a clickable link to verification emails
# EMAIL_VERIFY_EXPIRE_MINUTES=1440
# REQUIRE_EMAIL_VERIFICATION=false         # true → email accounts must verify before login

# --- Abuse controls ---
# RATE_LIMIT_ENABLED=true
# REDIS_URL=redis://localhost:6379/0       # or rediss://… (Upstash). Empty = per-process memory

# --- Moderation ---
# ADMIN_USERNAMES=yourusername             # comma-separated; grants /api/admin/*

# --- Notion (verified clubs only — see backend/NOTION.md) ---
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:8000/api/notion/oauth/callback
# NOTION_WEBHOOK_SECRET=                   # X-Notion-Signature HMAC key (verification_token)
# TOKEN_ENCRYPTION_KEY=                    # 32+ chars; empty → derived from JWT_SECRET (dev only)

# --- Push notifications (FCM HTTP v1 — covers Android + iOS via Firebase) ---
# PUSH_ENABLED=true
# FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json   # file path OR raw JSON string
# FCM_PROJECT_ID=                          # optional; defaults to project_id in the JSON
