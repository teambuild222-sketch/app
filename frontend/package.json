    "mapbox-gl": "^3.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.16.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
