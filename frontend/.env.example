# Copy to .env and fill in when the backend is ready.
# Vite only exposes vars prefixed with VITE_.

# Backend API for production builds (Capacitor) and `npm run build`.
# For `npm run dev`, see .env.development (proxy via Vite — works on phone Wi‑Fi).
VITE_API_URL=

# Dev proxy target when VITE_API_URL is empty in development (see vite.config.js)
# VITE_DEV_API_PROXY=https://simsor-api.onrender.com

# Example local backend:
# VITE_API_URL=http://localhost:8000

# Example Android emulator → host machine:
# VITE_API_URL=http://10.0.2.2:8000

# Example physical device on same Wi‑Fi (use your PC LAN IP):
# VITE_API_URL=http://192.168.1.10:8000

# Supabase Realtime (Chat Phase) — leave both empty to disable live chat
# delivery (REST chat still works, just without live push/presence).
# See backend/CHAT_SETUP.md for where to find these in your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Sign-In (Web OAuth client ID — same project as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
