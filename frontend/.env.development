# Dev-only overrides (npm run dev). "/" = same-origin: the app calls /api/... on the
# Vite dev server, which proxies to Render. This keeps phone/LAN testing free of CORS
# problems AND keeps the live backend enabled (an empty value would drop the app
# into offline mock mode, where signups never reach the server).
# Production/mobile builds still use VITE_API_URL from .env.
VITE_API_URL=/
VITE_DEV_API_PROXY=https://simsor-api.onrender.com
